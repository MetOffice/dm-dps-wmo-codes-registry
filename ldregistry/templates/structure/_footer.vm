    </div> <!-- End of container -->

 <footer class="o-footer">
  <div class="container">
    <div class="row">
      <div class="col-sm-6">
        <div class="">
          <div class="c-footer-credits">
            <h4 class="">$msg['footer.support.heading']</h4>
            <p>
              <a href="/ui/about/identifiers">Documentation regarding Identifiers</a> and how to identify entities contained in the registry.</p>
            </p>
            <p>
              <a href="https://github.com/UKGovLD/registry-core/wiki/Api#content-negotiation">Content negotiation</a>  is supported.
            </p>
          </div>
        </div>
      </div>

      <div class="col-sm-6">
        <h4>$msg['footer.about.heading']</h4>
        <p>
            Unless otherwise stated, all content is available under the
          <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" rel="license">Open Government Licence</a>
        </p>
        <p class="c-footer-epimorphics">
          <span class="i18n">$msg.get('footer.about.credit', "Epimorphics", "https://www.epimorphics.com")</span>
        </p>
        #if($registry.languageManager.useCookies)
          <p>
            $msg['footer.language.cookies.notice']
          </p>
        #end
          ## Last modified dates
          <div class="text-muted small" style="margin-top: 15px">
              #set($queryResults = $lib.reg.query("SELECT ?modified WHERE { ?item dct:modified ?modified } ORDER BY DESC(?modified) LIMIT 1"))
              #if($queryResults && $queryResults.size() > 0)
                #set($lastModifiedWrapper = $queryResults.get(0).get("modified"))
                #if($lastModifiedWrapper)
                    #set($lastModified = $lastModifiedWrapper.asLiteral())
                    <div>
                        <strong>Last Content Update: </strong>
                        #if($lastModified.datatype.toString() == "http://www.w3.org/2001/XMLSchema#date")
                            $lib.printDatetime("d MMM yyyy", $lastModified)
                        #else
                            $lib.printDatetime(lastModified)
                        #end
                    </div>
                #end
              #end

              #if($registry.backupService)
                  #set($backupStatus = $registry.backupService.getStatus())
                  #if($backupStatus)
                      <div><strong>Last deployed:</strong> $backupStatus</div>
                  #end
              #end
          </div>
      </div>

    </div><!--/.row-->
  </div>
</footer>
    <script>
      window.registry = {
        assets: "$lib.reg.jsEncode($assets)",
        language: "$lib.reg.jsEncode($language)"
      };
    </script>

    <script src="$assets/js/bootstrap.min.js"></script>
    <script src="$assets/js/jquery.dataTables.min.js"></script>
    <script src="$assets/js/bootstrap-editable.min.js"></script>
    <script src="$assets/js/ui.js"></script>
    #if($extraJS)
      #foreach($file in $extraJS.split(","))
        <script src="$assets/js/$file"></script>
      #end
    #end
  </body>
</html>
